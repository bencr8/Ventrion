{
  "version": "0.1.0",
  "name": "ventrion",
  "instructions": [
    {
      "name": "initializeCompany",
      "accounts": [
        { "name": "founder", "isMut": true, "isSigner": true },
        { "name": "company", "isMut": true, "isSigner": false },
        { "name": "mint", "isMut": true, "isSigner": false },
        { "name": "founderTokenAccount", "isMut": true, "isSigner": false },
        { "name": "paymentMint", "isMut": false, "isSigner": false },
        { "name": "reserveVault", "isMut": true, "isSigner": false },
        { "name": "dividendVault", "isMut": true, "isSigner": false },
        { "name": "supplierWallet", "isMut": false, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false },
        { "name": "associatedTokenProgram", "isMut": false, "isSigner": false },
        { "name": "rent", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "companyName", "type": "string" },
        { "name": "reserveRateBps", "type": "u16" },
        { "name": "ceoSalaryBps", "type": "u16" }
      ]
    },
    {
      "name": "registerProduct",
      "accounts": [
        { "name": "founder", "isMut": true, "isSigner": true },
        { "name": "company", "isMut": true, "isSigner": false },
        { "name": "product", "isMut": true, "isSigner": false },
        { "name": "supplierWallet", "isMut": false, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "productId", "type": "string" },
        { "name": "price", "type": "u64" },
        { "name": "cogs", "type": "u64" }
      ]
    },
    {
      "name": "processOrderPayment",
      "accounts": [
        { "name": "customer", "isMut": true, "isSigner": true },
        { "name": "company", "isMut": true, "isSigner": false },
        { "name": "product", "isMut": true, "isSigner": false },
        { "name": "customerTokenAccount", "isMut": true, "isSigner": false },
        { "name": "supplierTokenAccount", "isMut": true, "isSigner": false },
        { "name": "supplierWallet", "isMut": false, "isSigner": false },
        { "name": "reserveVault", "isMut": true, "isSigner": false },
        { "name": "dividendVault", "isMut": true, "isSigner": false },
        { "name": "founderTokenAccount", "isMut": true, "isSigner": false, "isOptional": true },
        { "name": "tokenProgram", "isMut": false, "isSigner": false }
      ],
      "args": []
    },
    {
      "name": "claimDividends",
      "accounts": [
        { "name": "shareholder", "isMut": true, "isSigner": true },
        { "name": "company", "isMut": true, "isSigner": false },
        { "name": "shareholderEquityAccount", "isMut": false, "isSigner": false },
        { "name": "shareholderReceipt", "isMut": true, "isSigner": false },
        { "name": "dividendVault", "isMut": true, "isSigner": false },
        { "name": "shareholderPaymentAccount", "isMut": true, "isSigner": false },
        { "name": "mint", "isMut": false, "isSigner": false },
        { "name": "tokenProgram", "isMut": false, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": []
    },
    {
      "name": "createProposal",
      "accounts": [
        { "name": "proposer", "isMut": true, "isSigner": true },
        { "name": "company", "isMut": true, "isSigner": false },
        { "name": "proposal", "isMut": true, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "proposalType", "type": { "defined": "ProposalType" } },
        { "name": "title", "type": "string" },
        { "name": "description", "type": "string" },
        { "name": "targetU64", "type": "u64" },
        { "name": "targetPubkey", "type": "publicKey" },
        { "name": "votingDurationSeconds", "type": "i64" }
      ]
    },
    {
      "name": "castVote",
      "accounts": [
        { "name": "voter", "isMut": true, "isSigner": true },
        { "name": "company", "isMut": false, "isSigner": false },
        { "name": "proposal", "isMut": true, "isSigner": false },
        { "name": "voterEquityAccount", "isMut": false, "isSigner": false },
        { "name": "voteReceipt", "isMut": true, "isSigner": false },
        { "name": "systemProgram", "isMut": false, "isSigner": false }
      ],
      "args": [
        { "name": "approve", "type": "bool" }
      ]
    },
    {
      "name": "executeProposal",
      "accounts": [
        { "name": "caller", "isMut": true, "isSigner": true },
        { "name": "company", "isMut": true, "isSigner": false },
        { "name": "proposal", "isMut": true, "isSigner": false },
        { "name": "product", "isMut": true, "isSigner": false, "isOptional": true }
      ],
      "args": []
    }
  ],
  "accounts": [
    { "name": "CompanyAccount" },
    { "name": "ProductAccount" },
    { "name": "ProposalAccount" },
    { "name": "ShareholderReceipt" },
    { "name": "VoteReceipt" }
  ],
  "types": [
    {
      "name": "ProposalType",
      "type": {
        "kind": "enum",
        "variants": [
          { "name": "UpdateCogs" },
          { "name": "UpdatePrice" },
          { "name": "UpdateSupplier" },
          { "name": "UpdateCeoSalary" },
          { "name": "UpdateReserveRate" }
        ]
      }
    }
  ]
}
